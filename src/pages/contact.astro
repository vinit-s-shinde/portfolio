---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Input, Button, Textarea, Heading, Link, Notification } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout
  title="Contact"
  description="Contact Vinit Shinde, Software Development Engineer specializing in Java, Spring Boot, and Microservices, for opportunities, projects, collaborations, or professional connections."
>
  <PageHeader title="Contact" subtitle="Have a question? Get in touch with me!" bgType="gradient" />

  <section class="my-8">
    <div class="container">
      <Heading level="h2">Let's talk</Heading>
    </div>
  </section>

  <section class="container">
    <div class="grid grid-cols-1 gap-32 md:grid-cols-2">
      <!-- Contact Form -->
      <div class="space-content">
        <form
          name="contact"
          action="/"
          method="post"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="contact-form"
        >
          <Notification type="error" ariaLive="polite" variant="accent" hidden />

          <input type="hidden" name="form-name" value="contact" />
          <p hidden>
            <label>
              Don't fill this out if you're human:
              <input name="bot-field" />
            </label>
          </p>

          <Input name="name" label="Your name" required data-validation="Please enter your name" autocomplete="name" />

          <Input name="email" label="Email address" type="email" required autocomplete="email" />

          <Textarea name="message" label="Message" required />

          <Button htmlType="submit" type="primary"> Send Message </Button>
        </form>
      </div>

      <!-- Contact Information -->
      <div class="space-content">
        <Heading level="h3">Get in touch</Heading>

        <p class="text-lg">
          I'm a Software Development Engineer specializing in Java, Spring Boot, and Microservices. I'm
          always open to discussing development opportunities, backend systems, collaborative projects, and professional connections.
        </p>

        <p>
          You can reach out directly via email, connect on LinkedIn, explore my repositories on GitHub, or check out my coding and writing profiles below.
        </p>

        <!-- Email -->
        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:mail" size={20} class="flex-shrink-0" />

          <p>
            <span class="font-bold">Email:</span>
            <Link href="mailto:vineetshinde2559@gmail.com"> vineetshinde2559@gmail.com </Link>
          </p>
        </div>

        <!-- Phone -->
        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:phone" size={20} class="flex-shrink-0" />

          <p>
            <span class="font-bold">Phone:</span>
            <Link href="tel:+919623912441"> +91 9623912441 </Link>
          </p>
        </div>

        <!-- LinkedIn -->
        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:linkedin" size={20} class="flex-shrink-0" />

          <p>
            <span class="font-bold">LinkedIn:</span>
            <Link
              href="https://linkedin.com/in/vinit-s-shinde"
              isExternal
              target="_blank"
              rel="noopener noreferrer"
            >
              Connect on LinkedIn
            </Link>
          </p>
        </div>

        <!-- GitHub -->
        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:github" size={20} class="flex-shrink-0" />

          <p>
            <span class="font-bold">GitHub:</span>
            <Link
              href="https://github.com/vinit-s-shinde"
              isExternal
              target="_blank"
              rel="noopener noreferrer"
            >
              View GitHub Profile
            </Link>
          </p>
        </div>

        <!-- LeetCode -->
        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:code" size={20} class="flex-shrink-0" />

          <p>
            <span class="font-bold">LeetCode:</span>
            <Link
              href="https://leetcode.com/u/vinitshinde/"
              isExternal
              target="_blank"
              rel="noopener noreferrer"
            >
              View LeetCode Profile
            </Link>
          </p>
        </div>

        <!-- CodeChef -->
        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:terminal" size={20} class="flex-shrink-0" />

          <p>
            <span class="font-bold">CodeChef:</span>
            <Link
              href="https://codechef.com/users/nexus_2"
              isExternal
              target="_blank"
              rel="noopener noreferrer"
            >
              View CodeChef Profile
            </Link>
          </p>
        </div>

        <!-- Codeforces -->
        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:cpu" size={20} class="flex-shrink-0" />

          <p>
            <span class="font-bold">Codeforces:</span>
            <Link
              href="https://codeforces.com/profile/Vinit99"
              isExternal
              target="_blank"
              rel="noopener noreferrer"
            >
              View Codeforces Profile
            </Link>
          </p>
        </div>

        <!-- Medium -->
        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:book-open" size={20} class="flex-shrink-0" />

          <p>
            <span class="font-bold">Medium:</span>
            <Link
              href="https://vinitshinde.medium.com"
              isExternal
              target="_blank"
              rel="noopener noreferrer"
            >
              Read on Medium
            </Link>
          </p>
        </div>

        <!-- DEV Community -->
        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:code-2" size={20} class="flex-shrink-0" />

          <p>
            <span class="font-bold">DEV Community:</span>
            <Link
              href="https://dev.to/vinitshinde"
              isExternal
              target="_blank"
              rel="noopener noreferrer"
            >
              Read on DEV Community
            </Link>
          </p>
        </div>

        <!-- Resume -->
        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:file-text" size={20} class="flex-shrink-0" />

          <p>
            <span class="font-bold">Resume:</span>
            <Link href="/resume"> View my resume </Link>
          </p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    ;(() => {
      const form = document.querySelector('form[name="contact"]')

      if (!form || form.dataset.netlifyAjaxBound === 'true') {
        return
      }

      form.dataset.netlifyAjaxBound = 'true'

      let isSubmitting = false

      const submitButton = form.querySelector('button[type="submit"]')
      const errorNotification = form.querySelector('.notification')
      const errorNotificationContent = errorNotification?.querySelector('p')

      const setSubmissionError = (message) => {
        if (!errorNotification || !errorNotificationContent) return

        errorNotification.hidden = false
        errorNotification.setAttribute('role', 'alert')
        errorNotificationContent.innerHTML = `<strong>Message:</strong> ${message}`
        errorNotification.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault()

        if (isSubmitting) {
          return
        }

        if (!form.checkValidity()) {
          form.reportValidity()
          return
        }

        isSubmitting = true
        if (submitButton) {
          submitButton.disabled = true
        }

        try {
          const response = await fetch('/', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams(new FormData(form)).toString(),
          })

          if (!response.ok) {
            throw new Error('Your message could not be sent. Please try again.')
          }

          window.location.href = '/thank-you/'
        } catch (error) {
          const message = error instanceof Error ? error.message : 'Your message could not be sent. Please try again.'

          setSubmissionError(message)
          isSubmitting = false
          if (submitButton) {
            submitButton.disabled = false
          }
        }
      })
    })()
  </script>
  <style>
    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .contact-form > button {
      margin-top: 0.5rem;
    }
  </style>
</DefaultLayout>
