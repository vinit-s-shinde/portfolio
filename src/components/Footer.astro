---
import CallToAction from './CallToAction.astro'
import Logo from './Logo.astro'
import { Heading, Link } from 'accessible-astro-components'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const currentYear = new Date().getFullYear()
---

<footer>
  <CallToAction />
  <section class="py-20">
    <Heading level="h2" class="sr-only">Footer</Heading>

    <div class="container grid grid-cols-1 gap-8 md:grid-cols-3">
      <!-- About -->
      <div class="flex flex-col gap-4 md:col-start-1">
        <Heading level="h3" size="h6">About Me</Heading>

        <p class="leading-[1.75]">
          I'm Vinit Shinde, a Software Development Engineer specializing in Java,
          Spring Boot, and Microservices, focused on building reliable, scalable,
          and high-performance backend systems.
        </p>

        <p class="leading-[1.75]">
          I enjoy solving complex problems, exploring JVM architectures, and
          continuously improving my software engineering skills.
        </p>
      </div>

      <!-- Contact & Profiles -->
      <div class="flex flex-col gap-4 md:col-start-3">
        <Logo loading="lazy" />

        <p class="leading-[1.75]">
          Focused on backend architecture, modern Java development, and building
          production-ready microservices that demonstrate clean code and high performance.
        </p>

        <div class="flex flex-wrap gap-3">
          <Link
            href="https://github.com/vinit-s-shinde"
            isExternal={true}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </Link>

          <Link
            href="https://linkedin.com/in/vinit-s-shinde"
            isExternal={true}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </Link>

          <Link
            href="https://vinitshinde.medium.com"
            isExternal={true}
            target="_blank"
            rel="noopener noreferrer"
          >
            Medium
          </Link>

          <Link
            href="https://dev.to/vinitshinde"
            isExternal={true}
            target="_blank"
            rel="noopener noreferrer"
          >
            DEV.to
          </Link>

          <Link
            href="https://leetcode.com/u/vinitshinde/"
            isExternal={true}
            target="_blank"
            rel="noopener noreferrer"
          >
            LeetCode
          </Link>

          <Link
            href="https://codechef.com/users/nexus_2"
            isExternal={true}
            target="_blank"
            rel="noopener noreferrer"
          >
            CodeChef
          </Link>

          <Link
            href="https://codeforces.com/profile/Vinit99"
            isExternal={true}
            target="_blank"
            rel="noopener noreferrer"
          >
            Codeforces
          </Link>

          <Link href="mailto:vineetshinde2559@gmail.com">
            Email
          </Link>

          <Link href="/contact">
            Contact
          </Link>

          <Link href="/blog">
            Blog
          </Link>

          <Link href="/rss.xml">
            RSS
          </Link>

          <Link href="/sitemap">
            Sitemap
          </Link>
        </div>
      </div>
    </div>

  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between items-center">
      <div class="flex flex-col gap-1">
        <p>
          &copy; {currentYear} Vinit Shinde.
        </p>
        <p class="text-sm">
          Built with Astro and modern web technologies.
        </p>
      </div>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
